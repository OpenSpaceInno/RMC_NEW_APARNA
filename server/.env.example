# Database Configuration (Local MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=Admin@123
DB_NAME=rmc_gate_system
PORT=3001

# ==============================================================================
# Automatic Edge-to-Cloud Database Synchronization (Local PC -> Cloud Server)
# ==============================================================================
# When running as an .exe on a local computer, set CLOUD_SERVER_URL to your central
# cloud server endpoint (e.g. https://rmc.yourdomain.com or http://213.210.37.249:3001).
# All data stored in the local database will automatically sync to the server database!
CLOUD_SYNC_ENABLED=true
CLOUD_SERVER_URL=http://213.210.37.249:3001
CLOUD_SYNC_SECRET=Aparna_RMC_Cloud_Sync_Secret_2026!
CLOUD_SYNC_INTERVAL_MS=5000
PLANT_ID=PL01

# Optional Direct MySQL-to-MySQL Sync (alternative to HTTP sync):
# REMOTE_DB_HOST=213.210.37.249
# REMOTE_DB_PORT=3306
# REMOTE_DB_USER=rmc_user
# REMOTE_DB_PASSWORD=SecureRmcPassword2026!
# REMOTE_DB_NAME=rmc_gate_system

# ANPR Configuration
# Get free API key from https://platerecognizer.com (2,500 detections/month free)
PLATERECOGNIZER_API_KEY=your_api_key_here

# Once you add your API key above, the system will automatically:
