# ==============================================================================
# Aparna RMC Gate-to-Exit Enterprise System - Production Environment Configuration
# Plant PL01 - Shamshabad Industrial Terminal
# ==============================================================================

# Core Application Server
NODE_ENV=production
PORT=3001
VITE_API_URL=https://rmc.aparna-plant01.internal/api

# Cryptographic Token Authentication (8-Hour Shift Expiry)
JWT_SECRET=Aparna_RMC_Gate_Secure_Industrial_JWT_Key_2026_Sha256
JWT_EXPIRY_SECONDS=28800

# High-Performance Industrial Database (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rmc_prod_svc
DB_PASSWORD=SecureIndustrialPassword@2026
DB_NAME=Aparna_RMC_Db
DB_CONNECTION_LIMIT=50

# Weighbridge Indicator Scale Connectivity
# Modes: 'tcp' (Moxa/Ethernet Indicator) | 'serial' (RS-232 COM port) | 'simulator'
SCALE_MODE=tcp
SCALE_INDICATOR_MODEL=Mettler Toledo 8142
SCALE_PROTOCOL=toledo
SCALE_HOST=192.168.0.150
SCALE_PORT=4001
SCALE_SERIAL_PORT=/dev/ttyUSB0
SCALE_BAUD_RATE=9600
SCALE_UNIT=kg
SCALE_UPDATE_INTERVAL_MS=100

# Boom Barrier Actuator (Moxa ioLogik E1214 IP Relay over Modbus TCP)
BARRIER_RELAY_HOST=192.168.0.160
BARRIER_RELAY_PORT=502
BARRIER_RELAY_CHANNEL=0
BARRIER_PULSE_DURATION_MS=3000

# High-Resolution ANPR & Surveillance Cameras
CAM_INBOUND_ANPR_RTSP=rtsp://admin:AparnaGate2026@192.168.0.101:554/Streaming/Channels/101
CAM_OUTBOUND_ANPR_RTSP=rtsp://admin:AparnaGate2026@192.168.0.102:554/Streaming/Channels/101
CAM_SCALE_OVERHEAD_RTSP=rtsp://admin:AparnaGate2026@192.168.0.103:554/Streaming/Channels/101
CAM_CHUTE_INSPECTOR_RTSP=rtsp://admin:AparnaGate2026@192.168.0.104:554/Streaming/Channels/101

# MediaMTX Low-Latency HLS Video Transmuxer
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_RTSP_PORT=8554

# Corporate SAP S/4HANA Enterprise Integration
SAP_ENVIRONMENT=production
SAP_CONNECTION_TYPE=odata_cloud_connector
SAP_SCC_LOCATION_ID=HYD_RMC_PLANT_01
SAP_S4H_HOST=sap-s4h.aparna-rmc.internal
SAP_S4H_PORT=44300
SAP_S4H_CLIENT=100
SAP_USER=RMC_GATE_SVC
SAP_PASSWORD=AparnaRmcSapEnterprise2026!

# Background Queue Worker Config
POLL_INTERVAL_MS=30000
QUEUE_BATCH_SIZE=10

